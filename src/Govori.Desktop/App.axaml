<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Govori.App" Name="Govori" RequestedThemeVariant="Light">
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#7160DF</Color>
    <Color x:Key="SystemAccentColorDark1">#6250CD</Color>
    <Color x:Key="SystemAccentColorLight1">#9385EE</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="False"/></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="16,10"/></Style>
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#292936"/><Setter Property="Background" Value="White"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E9E9F1"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.nav"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#807C93"/></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="#EEEBFD"/><Setter Property="Foreground" Value="#7160DF"/></Style>
    <Style Selector="Button.shortcut"><Setter Property="Foreground" Value="#7160DF"/><Setter Property="Background" Value="#EEEBFD"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="145"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.small"><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#807C93"/></Style>
    <Style Selector="Button.icon"><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="TextBox"><Setter Property="ScrollViewer.AllowAutoHide" Value="False"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="#F7F7FB"/><Setter Property="BorderBrush" Value="#E9E9F1"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="#F7F7FB"/><Setter Property="BorderBrush" Value="#E9E9F1"/><Setter Property="MinHeight" Value="34"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="#9393A6"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Application.Styles>
</Application>
